  "lead_insight": {
    "id": "insight-changing-grpc-from-pick-first-to-round-robin-mad-a59c9e38",
    "claim": "A gRPC reconnection override caused thousands of clients to repeatedly SYN flood deleted service IPs during rollouts.",
    "context": "Round-robin reconnects run in the background for every upstream.",
    "evidence": "But what this meant is that we had very very very aggressive reconnection settings, and it was all trying to happen in the background to all the upstreams all at once. And this sort of explained where a SYN flood was coming from, because we had, you know, thousands of alerting engine pods, and they were all trying to reconnect every 300 millisecond to each metric service pod.",
    "timestamp": 2130.42,
    "slide_relation": "elaborates_slide",
    "stance": "asserted",
    "speaker": "instructor",
    "verification": "partially_supported",
    "tags": [
      "gRPC",
      "reconnection",
      "SYN flood"
    ],
    "redacted": false
  },
  "insights": [
    {
      "id": "insight-a-deleted-pod-ip-continued-receiving-traffic-bec-095da0e3",
      "claim": "A deleted pod IP continued receiving traffic because service discovery propagation outlasted pod termination and routing cleanup.",
      "context": "Clients retained stale addresses during the rollout window.",
      "evidence": "And the clients would continue to try and send packets to this IP address because it takes some time for our service discovery to propagate this information all the way back to the clients. And as far as the VPC fabric is concerned, the IP address is still attached to this interface, so any packet that is sent to this particular IP address, VPC fabric will still send that to the same node.",
      "timestamp": 1289.94,
      "slide_relation": "elaborates_slide",
      "stance": "asserted",
      "speaker": "instructor",
      "verification": "partially_supported",
      "tags": [
        "Kubernetes",
        "service discovery",
        "stale IPs"
      ],
      "redacted": false
    },
    {
      "id": "insight-the-final-fix-removed-aggressive-grpc-reconnect--4a3fbe16",
      "claim": "The final fix removed aggressive gRPC reconnect overrides and restored default backoff values.",
      "context": "The defaults waited a few seconds between reconnection attempts.",
      "evidence": "And very surprisingly here, the fix for this just ended up being to delete these overrides that we set on the reconnection settings in grpc, instead of use, instead of overriding them to be like in hundreds of milliseconds, we deleted them and used the default values, which is like, you know, a few seconds for each of these, like, to, to wait for how long you should reconnect.",
      "timestamp": 2152.619,
      "slide_relation": "elaborates_slide",
      "stance": "asserted",
      "speaker": "instructor",
      "verification": "supported",
      "tags": [
        "gRPC",
