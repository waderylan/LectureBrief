# LLM — Codex CLI is the default and reuses `codex login` authentication.
LLM_PROVIDER=codex
LLM_MODEL=gpt-5.6-luna
# Optional compatibility backend: set LLM_PROVIDER=claude and choose a Claude model.

# Local Voice Memos transcription. YouTube caption ingestion needs no provider.
STT_PROVIDER=whisper
# Installed defaults are under %LOCALAPPDATA%/whisper.cpp; override if needed.
WHISPER_CLI=
WHISPER_MODEL=
FFMPEG=
# Optional hosted fallback: set STT_PROVIDER=deepgram.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Optional if ffprobe is not on PATH (required only for local media metadata).
FFPROBE=

# Site (Day 5)
DATABASE_URL=
AUTH_SECRET=
